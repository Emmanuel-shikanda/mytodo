<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Tasks</title>
  <link rel="stylesheet" href="/assets/mytodostyles.css">
</head>
<body>
<main class="app">

  
   <%- include('partials/navbar') %>

  <header class="top">
    <div class="bar"><span><img src="/assets/img/icons8-calender-85.png" alt="calendar" class="icon"></span><span id="leo"></span><span><img src="/assets/img/icons8-clock-100.png" alt="clock" class="icon"></span></div>
    <div class="hero">
    <div><h1>Today</h1><p id="numberoftodos"></p></div>
      
<a class="add" href="create">Add New</a>
    </div>
  </header>

  <section class="tasks">
    <div class="days" id="days">
      
    </div>

    <h2>My Tasks</h2>
    <!-- Task list -->
      <ul>

   <% todos.forEach(function(todo){ %>
        
  <li class="task" data-date="<%= todo.date %>" >

    <time> <%= todo.start %> – <%= todo.end %></time>

    <span><strong><%= todo.title %></strong><small><%= todo.description %></small></span>

    <div class="task-actions">

      <form action="/todo/<%=todo._id%>/delete" method="post">
        <button class="del" type="submit" aria-label="Delete task"><img class="icon-trash" src="assets/img/icons8-trash-can-100.png" alt=""></button>
      </form>

     <input 
    type="checkbox"
    class="complete-task"
    data-id="<%= todo._id %>"
    <%= todo.completed ? 'checked' : '' %>
>

    </div>

  </li>

  <% })%>

</ul>
    
  </section>

</main>

  <script src="/assets/home.js"></script>
</body>
</html>