<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Tasks</title>
  <link rel="stylesheet" href="/assets/mytodostyles.css">
</head>
<body>
<main class="app">

  
   <%- include('partials/navbar') %>

  <header class="top">
    <div class="bar"><span><img src="/assets/img/icons8-calender-85.png" alt="calendar" class="icon"></span><span>14 Sept</span><span><img src="/assets/img/icons8-clock-100.png" alt="clock" class="icon"></span></div>
    <div class="hero">
      <div><h1>Today</h1><p>6 Tasks</p></div>
      
<a class="add" href="create">Add New</a>
    </div>
  </header>

  <section class="tasks">
    <div class="days">
      <div class="day on"><b>14</b>Mon</div>
      <div class="day"><b>15</b>Tue</div>
      <div class="day"><b>16</b>Wed</div>
      <div class="day"><b>17</b>Thu</div>
<div class="day"><b>18</b>Fri</div>
<div class="day"><b>19</b>Sat</div>
<div class="day"><b>20</b>Sun</div>
<div class="day"><b>21</b>Mon</div>
    </div>

    <h2>My Tasks</h2>
    <!-- Task list -->
      <ul>

   <% todos.forEach(function(todo){ %>
        
  <li class="task">

    <time> <%= todo.start %> – <%= todo.end %></time>

    <span><strong><%= todo.title %></strong><small><%= todo.description %></small></span>

    <div class="task-actions">

      <form action="/todo/<%=todo._id%>/delete" method="post">
        <button class="del" type="submit" aria-label="Delete task"><img class="icon-trash" src="assets/img/icons8-trash-can-100.png" alt=""></button>
      </form>

     <input type="checkbox"
    <% if (todo.completed) { %>
        checked
    <% } else { %>

    <% } %>

    
> 

    </div>

  </li>

  <% })%>

</ul>
    
  </section>

</main>
</body>
</html>