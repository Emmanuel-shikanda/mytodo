<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Forgot password</title>
  <link rel="stylesheet" href="/assets/mytodostyles.css">
</head>
<body>
<main class="app">

  <header class="top au-top">
    <div class="au-logo">🔑</div>
    <h1 class="au-title">Forgot password?</h1>
    <p class="au-sub">No problem. Enter your email and we will send you a link to reset it.</p>
  </header>

  <form class="au-card" action="/forgot-password" method="post">

    <div class="au-field">
      <label class="au-label" for="fp-email">Email</label>
      <input class="au-input" id="fp-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>
    </div>

    <button class="au-button" type="submit">Send reset link</button>

    <p class="au-switch">Remembered it? <a class="au-link" href="login">Back to log in</a></p>

  </form>
</main>
</body>
</html>