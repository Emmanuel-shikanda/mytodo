<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/assets/mytodostyles.css">
  <title>Document</title>
</head>
<body>

   <%- include('partials/navbar') %>

  
<main class="app">

  <!-- Left side on desktop: photo + email -->
  <header class="top pf-top">
    <div class="bar">
       <a href="/"><img src="/assets/img/icons8-back-arrow-100.png" alt="back"class="icon"></a>
      <strong>Profile</strong>
      <span></span>
    </div>

    <h1 class="big">My Profile</h1>

    <div class="pf-user">
      <div class="pf-avatar">JD</div>
      <p class="pf-email">john@example.com</p>
    </div>
  </header>

  <!-- Right side on desktop: everything else -->
  <section class="pf-card">

    <div class="pf-stats">
      <div class="pf-stat"><b>24</b>Total</div>
      <div class="pf-stat"><b>18</b>Done</div>
      <div class="pf-stat"><b>6</b>Pending</div>
    </div>

    <ul class="pf-list">
      <li><span>Name</span> John Doe</li>
      <li><span>Email</span> john@example.com</li>
      <li><span>Phone</span> +254 700 000 000</li>
      <li><span>Joined</span> Oct 2026</li>
    </ul>

    <div class="pf-actions">
      <a class="pf-btn" href="editprofile">Edit Profile</a>
      <a class="pf-btn pf-btn-light" href="login">Log out</a>
    </div>

  </section>
</main>

</body>
</html>