<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Enter code</title>
  <link rel="stylesheet" href="/assets/mytodostyles.css">
</head>
<body>
<main class="app">

  <header class="top au-top">
    <div class="au-logo">✉</div>
    <h1 class="au-title">reset-password</h1>
    <p class="au-sub">Enter and confirm the new password below</p>
  </header>

  <form class="au-card" action="/verify" method="post">

    <% if (typeof error !== 'undefined') { %>
    <p class="error-message"><%= error %></p>
<% } %> 

<input type="hidden" name="token" value="<%= token %>">

    <div class="au-field">
      <label class="au-label" for="vc-code">New password</label>
      <input class="au-input" id="vc-code" type="password" name="password" placeholder="Enter new password" autocomplete="new-password" required>
    </div>

    <div class="au-field">
      <label class="au-label" for="vc-code">Confirm password</label>
      <input class="au-input" id="vc-code" type="password" name="confirmpassword" placeholder="Confirm new password" autocomplete="new-password" required>
    </div>

    <button class="au-button" type="submit">Change password</button>

    <p class="au-switch">Did not get it? <a class="au-link" href="/forgotpassword">Send a new link</a></p>
    <p class="au-switch"><a class="au-link" href="login">Back to log in</a></p>

  </form>
</main>
</body>
</html>