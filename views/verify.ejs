<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Enter code</title>
  <link rel="stylesheet" href="/assets/mytodostyles.css">
</head>
<body>
<main class="app">

  <header class="top au-top">
    <div class="au-logo">✉</div>
    <h1 class="au-title">Check your email</h1>
    <p class="au-sub">We sent a 6-digit code to your email. Enter it below to continue.</p>
  </header>

  <form class="au-card" action="/verify-code" method="post">

    <div class="au-field">
      <label class="au-label" for="vc-code">Verification code</label>
      <input class="au-input au-code" id="vc-code" type="text" name="code"
             inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
             placeholder="000000" autocomplete="one-time-code" required>
    </div>

    <button class="au-button" type="submit">Verify code</button>

    <p class="au-switch">Did not get it? <a class="au-link" href="/forgot-password">Send a new code</a></p>
    <p class="au-switch"><a class="au-link" href="login">Back to log in</a></p>

  </form>
</main>
</body>
</html>